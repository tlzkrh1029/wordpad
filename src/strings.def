// ---- Messages ----
X(S_MSG_SAVECHANGES,    L"%s의 변경 내용을 저장하시겠습니까?", L"Do you want to save changes to %s?")
X(S_MSG_SAVE,           L"저장(&S)",                        L"&Save")
X(S_MSG_DONTSAVE,       L"저장 안 함(&N)",                  L"Do&n't Save")
X(S_MSG_CANCEL,         L"취소",                            L"Cancel")
X(S_MSG_OPENFAILED,     L"파일을 열 수 없습니다.\n%s",      L"The file could not be opened.\n%s")
X(S_MSG_SAVEFAILED,     L"파일을 저장할 수 없습니다.\n%s",  L"The file could not be saved.\n%s")
X(S_MSG_UNSUPPORTED,    L"지원하지 않는 파일 형식입니다.\n%s", L"This file format is not supported.\n%s")
X(S_MSG_OLDDOC,         L"이 파일은 이전 Word 이진 형식(.doc)이므로 열 수 없습니다. Word에서 .docx 또는 .rtf로 저장한 다음 다시 열어 주십시오.\n%s", L"This file uses the legacy Word binary format (.doc) and cannot be opened. Save it as .docx or .rtf first.\n%s")
X(S_MSG_TEXTONLY,       L"이 문서를 일반 텍스트로 저장하면 서식, 그림, 개체가 모두 제거됩니다.\n\n계속 저장하시겠습니까?", L"Saving this document as plain text will remove all formatting, pictures and objects.\n\nDo you want to continue?")
X(S_MSG_LOSSY,          L"이 형식으로 저장하면 일부 서식이나 개체가 유지되지 않을 수 있습니다.\n\n계속 저장하시겠습니까?", L"Some formatting or objects may not be preserved in this format.\n\nDo you want to continue?")
X(S_MSG_ANSILOSS,       L"이 문서에는 ANSI 인코딩으로 표현할 수 없는 문자가 있습니다. ANSI로 저장하면 해당 문자가 손실됩니다.\n\n계속 저장하시겠습니까?", L"This document contains characters that cannot be represented in the ANSI encoding and will be lost.\n\nDo you want to continue?")
X(S_MSG_NOTFOUND,       L"\"%s\"을(를) 찾을 수 없습니다.",  L"Cannot find \"%s\".")
X(S_MSG_REPLACED,       L"%d개 항목을 바꿨습니다.",         L"%d replacements were made.")
X(S_MSG_SEARCHDONE,     L"문서 검색을 마쳤습니다.",         L"Finished searching the document.")
X(S_MSG_PICTUREFAILED,  L"그림을 삽입할 수 없습니다.\n%s",  L"The picture could not be inserted.\n%s")
X(S_MSG_OBJECTFAILED,   L"개체를 삽입할 수 없습니다.",      L"The object could not be inserted.")
X(S_MSG_PRINTFAILED,    L"문서를 인쇄할 수 없습니다.",      L"The document could not be printed.")
X(S_MSG_NOPRINTER,      L"사용할 수 있는 프린터가 없습니다. Windows 설정에서 프린터를 추가한 다음 다시 시도해 주십시오.", L"No printer is available. Add a printer in Windows Settings and try again.")
X(S_MSG_INVALIDNUMBER,  L"올바른 숫자를 입력해 주십시오.",  L"Please enter a valid number.")
X(S_MSG_INVALIDSIZE,    L"글꼴 크기는 1에서 1638 사이의 숫자여야 합니다.", L"The font size must be a number between 1 and 1638.")
X(S_MSG_ASSOC_DONE,     L"RichPad를 .rtf, .docx, .odt, .txt 파일의 연결 프로그램 목록에 등록했습니다.\n\n기본 앱으로 지정하려면 파일을 마우스 오른쪽 단추로 누르고 [연결 프로그램] > [다른 앱 선택]에서 RichPad를 선택한 다음 [항상]을 누르십시오.", L"RichPad has been added to the \"Open with\" list for .rtf, .docx, .odt and .txt files.\n\nTo make it the default, right-click a file, choose Open with > Choose another app, select RichPad and click Always.")
X(S_MSG_ASSOC_ASK,      L"RichPad를 .rtf, .docx, .odt, .txt 파일의 연결 프로그램으로 등록하시겠습니까?\n\n현재 사용자 계정에만 적용되며, 관리자 권한은 필요하지 않습니다.", L"Register RichPad as a program for .rtf, .docx, .odt and .txt files?\n\nThis applies to the current user only and does not require administrator rights.")
X(S_MSG_ASSOC_REGISTER, L"등록(&R)",                        L"&Register")
X(S_MSG_ASSOC_REMOVE,   L"등록 해제(&U)",                   L"&Unregister")
X(S_MSG_ASSOC_REMOVED,  L"파일 형식 연결을 해제했습니다.",  L"File associations were removed.")
X(S_MSG_READONLY,       L"이 파일은 읽기 전용입니다. 다른 이름으로 저장해 주십시오.", L"This file is read-only. Save it under a different name.")
X(S_MSG_CONVERTWARN,    L"이 문서에는 RichPad에서 표시할 수 없는 내용이 있을 수 있습니다. 원본을 보존하려면 다른 이름으로 저장하십시오.", L"This document may contain content that RichPad cannot display. Save under a different name to keep the original.")

